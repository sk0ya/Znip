<!--
  ライトテーマのパレット。
  Znip.ico(ティール→インディゴのグラデーションZ / 生成りの地)から色を起こしている。
  Dark.xaml と完全に同じキーを定義すること(実行時に丸ごと差し替えるため)。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 面 ===== -->
    <!-- タイトルバー / ステータスバー -->
    <SolidColorBrush x:Key="ChromeBg" Color="#F6F5F2"/>
    <!-- 副次的な面(グループ・一覧ペイン) -->
    <SolidColorBrush x:Key="ContentBg" Color="#FBFAF8"/>
    <!-- 主要な面(エディタ・入力欄・設定カード) -->
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PopupBg" Color="#FFFFFF"/>
    <!-- 本文入力欄(等幅)の地 -->
    <SolidColorBrush x:Key="FieldBg" Color="#F5F3EE"/>

    <SolidColorBrush x:Key="BorderSoft" Color="#E8E5DF"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#D5D1C9"/>
    <SolidColorBrush x:Key="HoverSoft" Color="#F1EFEA"/>

    <!-- ===== 文字 ===== -->
    <SolidColorBrush x:Key="TextMain" Color="#1D2027"/>
    <SolidColorBrush x:Key="TextSub" Color="#656B79"/>
    <SolidColorBrush x:Key="TextFaint" Color="#9CA0AC"/>

    <!-- ===== アクセント(インディゴ) ===== -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4A56C4"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3F4AB0"/>
    <SolidColorBrush x:Key="AccentPressBrush" Color="#363F9B"/>
    <!-- 明るい面に文字として載せる用 -->
    <SolidColorBrush x:Key="AccentTextBrush" Color="#414CBB"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E9EAF7"/>
    <SolidColorBrush x:Key="AccentSoftHoverBrush" Color="#DDDFF1"/>
    <!-- アクセント塗りの上に載せる文字色 -->
    <SolidColorBrush x:Key="AccentOnBrush" Color="#FFFFFF"/>

    <!-- ===== 副アクセント(ティール / キーワード表示) ===== -->
    <SolidColorBrush x:Key="TealBrush" Color="#12807A"/>
    <SolidColorBrush x:Key="TealSoftBrush" Color="#DFF0ED"/>
    <SolidColorBrush x:Key="TealTextBrush" Color="#0E6B66"/>

    <!-- ===== 破壊的操作 ===== -->
    <SolidColorBrush x:Key="DangerBrush" Color="#C4453F"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#AC3A35"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FAEAE8"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#B03A35"/>

    <!-- ===== スクロールバー ===== -->
    <SolidColorBrush x:Key="ScrollThumb" Color="#CFCBC2"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#B3AEA3"/>

    <!-- ===== ピッカー(テーマに追従) ===== -->
    <SolidColorBrush x:Key="PickerBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PickerBorder" Color="#E2DED7"/>
    <SolidColorBrush x:Key="PickerText" Color="#1D2027"/>
    <SolidColorBrush x:Key="PickerSub" Color="#767B88"/>
    <SolidColorBrush x:Key="PickerSelBg" Color="#E9EAF7"/>
    <SolidColorBrush x:Key="PickerHover" Color="#F3F1EC"/>
    <SolidColorBrush x:Key="PickerChipBg" Color="#DFF0ED"/>
    <SolidColorBrush x:Key="PickerChipText" Color="#0E6B66"/>
    <SolidColorBrush x:Key="PickerKeyCapBg" Color="#F1EFEA"/>
    <SolidColorBrush x:Key="PickerThumb" Color="#CFCBC2"/>
    <SolidColorBrush x:Key="PickerThumbHover" Color="#B3AEA3"/>

    <!-- ===== ロゴ(アイコンと同じティール→インディゴ) ===== -->
    <LinearGradientBrush x:Key="LogoBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#159C93" Offset="0"/>
        <GradientStop Color="#4A56C4" Offset="1"/>
    </LinearGradientBrush>

    <!-- ===== 影(浮くものだけ) ===== -->
    <DropShadowEffect x:Key="PopupShadow" BlurRadius="18" ShadowDepth="4"
                      Direction="270" Opacity="0.14" Color="#2A2621"/>
    <DropShadowEffect x:Key="DialogShadow" BlurRadius="28" ShadowDepth="6"
                      Direction="270" Opacity="0.22" Color="#2A2621"/>
    <DropShadowEffect x:Key="PickerShadow" BlurRadius="34" ShadowDepth="8"
                      Direction="270" Opacity="0.26" Color="#2A2621"/>

</ResourceDictionary>
