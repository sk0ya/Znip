<!--
  ライトテーマのパレット。
  Znip.ico(ティール→インディゴのグラデーションZ)から色を起こしている。
  無彩色はわずかに青みを持たせ、アクセントのインディゴと馴染ませる。
  Dark.xaml と完全に同じキーを定義すること(実行時に丸ごと差し替えるため)。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 面(奥 → 手前の順に明るくなる) ===== -->
    <!-- サイドバー / 設定ページの地 -->
    <SolidColorBrush x:Key="ChromeBg" Color="#F2F2F5"/>
    <!-- 一覧ペイン -->
    <SolidColorBrush x:Key="ContentBg" Color="#FAFAFB"/>
    <!-- エディタ・設定カード -->
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PopupBg" Color="#FFFFFF"/>
    <!-- 入力欄の地 -->
    <SolidColorBrush x:Key="FieldBg" Color="#F4F4F7"/>

    <SolidColorBrush x:Key="BorderSoft" Color="#E4E4EA"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#CDCDD6"/>
    <SolidColorBrush x:Key="HoverSoft" Color="#EAEAF0"/>

    <!-- ===== 文字 ===== -->
    <SolidColorBrush x:Key="TextMain" Color="#1B1B22"/>
    <SolidColorBrush x:Key="TextSub" Color="#5D5D6B"/>
    <SolidColorBrush x:Key="TextFaint" Color="#686877"/>

    <!-- ===== アクセント(インディゴ) ===== -->
    <SolidColorBrush x:Key="AccentBrush" Color="#5856D6"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4C4AC4"/>
    <SolidColorBrush x:Key="AccentPressBrush" Color="#4240B0"/>
    <!-- 明るい面に文字として載せる用 -->
    <SolidColorBrush x:Key="AccentTextBrush" Color="#4B49C8"/>
    <!-- 選択中の行など(アクセントをごく薄く) -->
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAEAFB"/>
    <SolidColorBrush x:Key="AccentSoftHoverBrush" Color="#DFDFF8"/>
    <!-- アクセント塗りの上に載せる文字色 -->
    <SolidColorBrush x:Key="AccentOnBrush" Color="#FFFFFF"/>

    <!-- ===== 副アクセント(ティール / 変数の表示) ===== -->
    <SolidColorBrush x:Key="TealBrush" Color="#0F8A80"/>
    <SolidColorBrush x:Key="TealSoftBrush" Color="#E2F3F0"/>
    <SolidColorBrush x:Key="TealTextBrush" Color="#0B6D65"/>

    <!-- ===== 破壊的操作 ===== -->
    <SolidColorBrush x:Key="DangerBrush" Color="#D1453F"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#B93A35"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FBEAE9"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#B53832"/>

    <!-- ===== スクロールバー ===== -->
    <SolidColorBrush x:Key="ScrollThumb" Color="#D3D3DC"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#B4B4C0"/>

    <!-- ===== ピッカー(テーマに追従) ===== -->
    <SolidColorBrush x:Key="PickerBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PickerBorder" Color="#E0E0E8"/>
    <SolidColorBrush x:Key="PickerText" Color="#1B1B22"/>
    <SolidColorBrush x:Key="PickerSub" Color="#626272"/>
    <SolidColorBrush x:Key="PickerSelBg" Color="#EAEAFB"/>
    <SolidColorBrush x:Key="PickerHover" Color="#F4F4F7"/>
    <SolidColorBrush x:Key="PickerChipBg" Color="#F0F0F4"/>
    <SolidColorBrush x:Key="PickerChipText" Color="#5D5D6B"/>
    <SolidColorBrush x:Key="PickerKeyCapBg" Color="#F2F2F5"/>
    <SolidColorBrush x:Key="PickerThumb" Color="#D3D3DC"/>
    <SolidColorBrush x:Key="PickerThumbHover" Color="#B4B4C0"/>

    <!-- ===== ロゴ(アイコンと同じティール→インディゴ) ===== -->
    <LinearGradientBrush x:Key="LogoBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#14A396" Offset="0"/>
        <GradientStop Color="#5856D6" Offset="1"/>
    </LinearGradientBrush>

    <!-- ===== 影(浮くものだけ) ===== -->
    <DropShadowEffect x:Key="PopupShadow" BlurRadius="18" ShadowDepth="4"
                      Direction="270" Opacity="0.12" Color="#1B1B40"/>
    <DropShadowEffect x:Key="DialogShadow" BlurRadius="28" ShadowDepth="6"
                      Direction="270" Opacity="0.18" Color="#1B1B40"/>
    <DropShadowEffect x:Key="PickerShadow" BlurRadius="34" ShadowDepth="8"
                      Direction="270" Opacity="0.22" Color="#1B1B40"/>

</ResourceDictionary>
