<!--
  ダークテーマのパレット。Light.xaml と同じキーを同じ順で定義する。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 面 ===== -->
    <SolidColorBrush x:Key="ChromeBg" Color="#14161E"/>
    <SolidColorBrush x:Key="ContentBg" Color="#191C25"/>
    <SolidColorBrush x:Key="CardBg" Color="#1E212C"/>
    <SolidColorBrush x:Key="PopupBg" Color="#242835"/>
    <SolidColorBrush x:Key="FieldBg" Color="#15171F"/>

    <SolidColorBrush x:Key="BorderSoft" Color="#2B2F3D"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#3A3F51"/>
    <SolidColorBrush x:Key="HoverSoft" Color="#262A36"/>

    <!-- ===== 文字 ===== -->
    <SolidColorBrush x:Key="TextMain" Color="#E8EAF0"/>
    <SolidColorBrush x:Key="TextSub" Color="#9AA0B0"/>
    <SolidColorBrush x:Key="TextFaint" Color="#6E7486"/>

    <!-- ===== アクセント(インディゴ / 暗い面用に明度を上げる) ===== -->
    <SolidColorBrush x:Key="AccentBrush" Color="#7C88F7"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#8E99F9"/>
    <SolidColorBrush x:Key="AccentPressBrush" Color="#6B77E4"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#A0AAFF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#282D48"/>
    <SolidColorBrush x:Key="AccentSoftHoverBrush" Color="#323856"/>
    <!-- 明るいアクセント塗りの上には暗い文字を載せる -->
    <SolidColorBrush x:Key="AccentOnBrush" Color="#12141D"/>

    <!-- ===== 副アクセント(ティール / キーワード表示) ===== -->
    <SolidColorBrush x:Key="TealBrush" Color="#3FBFB0"/>
    <SolidColorBrush x:Key="TealSoftBrush" Color="#173330"/>
    <SolidColorBrush x:Key="TealTextBrush" Color="#58D0C0"/>

    <!-- ===== 破壊的操作 ===== -->
    <SolidColorBrush x:Key="DangerBrush" Color="#E0625C"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#EC736D"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A2321"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#F08A85"/>

    <!-- ===== スクロールバー ===== -->
    <SolidColorBrush x:Key="ScrollThumb" Color="#3A3F51"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#4C5266"/>

    <!-- ===== ピッカー ===== -->
    <SolidColorBrush x:Key="PickerBg" Color="#1C1F2A"/>
    <SolidColorBrush x:Key="PickerBorder" Color="#333849"/>
    <SolidColorBrush x:Key="PickerText" Color="#E8EAF0"/>
    <SolidColorBrush x:Key="PickerSub" Color="#9AA0B0"/>
    <SolidColorBrush x:Key="PickerSelBg" Color="#2C3252"/>
    <SolidColorBrush x:Key="PickerHover" Color="#242835"/>
    <SolidColorBrush x:Key="PickerChipBg" Color="#173330"/>
    <SolidColorBrush x:Key="PickerChipText" Color="#58D0C0"/>
    <SolidColorBrush x:Key="PickerKeyCapBg" Color="#2A2F3F"/>
    <SolidColorBrush x:Key="PickerThumb" Color="#3A3F51"/>
    <SolidColorBrush x:Key="PickerThumbHover" Color="#4C5266"/>

    <!-- ===== ロゴ ===== -->
    <LinearGradientBrush x:Key="LogoBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#25BFB0" Offset="0"/>
        <GradientStop Color="#7C88F7" Offset="1"/>
    </LinearGradientBrush>

    <!-- ===== 影 ===== -->
    <DropShadowEffect x:Key="PopupShadow" BlurRadius="18" ShadowDepth="4"
                      Direction="270" Opacity="0.45" Color="#000000"/>
    <DropShadowEffect x:Key="DialogShadow" BlurRadius="28" ShadowDepth="6"
                      Direction="270" Opacity="0.55" Color="#000000"/>
    <DropShadowEffect x:Key="PickerShadow" BlurRadius="34" ShadowDepth="8"
                      Direction="270" Opacity="0.6" Color="#000000"/>

</ResourceDictionary>
