<!--
  ダークテーマのパレット。Light.xaml と同じキーを同じ順で定義する。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 面(奥 → 手前の順に明るくなる) ===== -->
    <SolidColorBrush x:Key="ChromeBg" Color="#141417"/>
    <SolidColorBrush x:Key="ContentBg" Color="#19191D"/>
    <SolidColorBrush x:Key="CardBg" Color="#1F1F24"/>
    <SolidColorBrush x:Key="PopupBg" Color="#28282E"/>
    <SolidColorBrush x:Key="FieldBg" Color="#26262C"/>

    <SolidColorBrush x:Key="BorderSoft" Color="#2D2D34"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#40404A"/>
    <SolidColorBrush x:Key="HoverSoft" Color="#26262D"/>

    <!-- ===== 文字 ===== -->
    <SolidColorBrush x:Key="TextMain" Color="#ECECF1"/>
    <SolidColorBrush x:Key="TextSub" Color="#A7A7B4"/>
    <SolidColorBrush x:Key="TextFaint" Color="#A0A0AF"/>

    <!-- ===== アクセント(インディゴ / 暗い面用に明度を上げる) ===== -->
    <SolidColorBrush x:Key="AccentBrush" Color="#8584F6"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#9695F8"/>
    <SolidColorBrush x:Key="AccentPressBrush" Color="#7372E8"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#A8A7FB"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#282845"/>
    <SolidColorBrush x:Key="AccentSoftHoverBrush" Color="#303052"/>
    <!-- 明るいアクセント塗りの上には暗い文字を載せる -->
    <SolidColorBrush x:Key="AccentOnBrush" Color="#101018"/>

    <!-- ===== 副アクセント(ティール / 変数の表示) ===== -->
    <SolidColorBrush x:Key="TealBrush" Color="#3CC2B2"/>
    <SolidColorBrush x:Key="TealSoftBrush" Color="#152E2B"/>
    <SolidColorBrush x:Key="TealTextBrush" Color="#5ED3C4"/>

    <!-- ===== 破壊的操作 ===== -->
    <SolidColorBrush x:Key="DangerBrush" Color="#E0625C"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#EC736D"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A2323"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#F08A85"/>

    <!-- ===== スクロールバー ===== -->
    <SolidColorBrush x:Key="ScrollThumb" Color="#3A3A43"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#50505B"/>

    <!-- ===== ピッカー ===== -->
    <SolidColorBrush x:Key="PickerBg" Color="#1F1F24"/>
    <SolidColorBrush x:Key="PickerBorder" Color="#34343C"/>
    <SolidColorBrush x:Key="PickerText" Color="#ECECF1"/>
    <SolidColorBrush x:Key="PickerSub" Color="#B0B0BF"/>
    <SolidColorBrush x:Key="PickerSelBg" Color="#2A2A48"/>
    <SolidColorBrush x:Key="PickerHover" Color="#26262C"/>
    <SolidColorBrush x:Key="PickerChipBg" Color="#2A2A31"/>
    <SolidColorBrush x:Key="PickerChipText" Color="#B4B4C0"/>
    <SolidColorBrush x:Key="PickerKeyCapBg" Color="#28282E"/>
    <SolidColorBrush x:Key="PickerThumb" Color="#3A3A43"/>
    <SolidColorBrush x:Key="PickerThumbHover" Color="#50505B"/>

    <!-- ===== ロゴ ===== -->
    <LinearGradientBrush x:Key="LogoBrush" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#22BFAF" Offset="0"/>
        <GradientStop Color="#7C7BF2" Offset="1"/>
    </LinearGradientBrush>

    <!-- ===== 影 ===== -->
    <DropShadowEffect x:Key="PopupShadow" BlurRadius="18" ShadowDepth="4"
                      Direction="270" Opacity="0.45" Color="#000000"/>
    <DropShadowEffect x:Key="DialogShadow" BlurRadius="28" ShadowDepth="6"
                      Direction="270" Opacity="0.55" Color="#000000"/>
    <DropShadowEffect x:Key="PickerShadow" BlurRadius="34" ShadowDepth="8"
                      Direction="270" Opacity="0.6" Color="#000000"/>

</ResourceDictionary>
