<Window x:Class="Znip.Views.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Znip"
        Icon="Znip.ico"
        Width="480" MaxHeight="440"
        SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI, Yu Gothic UI"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{StaticResource PickerBg}" CornerRadius="12"
            BorderBrush="{StaticResource PickerBorder}" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 検索欄 -->
            <Grid Grid.Row="0" Margin="6,4,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="{StaticResource PickerSub}" VerticalAlignment="Center" Margin="6,0,10,0"/>
                <Grid Grid.Column="1">
                    <TextBox x:Name="SearchBox"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource PickerText}"
                             CaretBrush="{StaticResource PickerText}"
                             FontSize="17" Padding="0,10"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="SearchHint" Text="スニペットを検索…"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center" FontSize="17"
                               Foreground="{StaticResource PickerSub}"/>
                </Grid>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{StaticResource PickerBorder}" Margin="2,4,2,6"/>

            <!-- 結果リスト -->
            <ListBox x:Name="ResultList" Grid.Row="2"
                     BorderThickness="0"
                     Background="Transparent"
                     MaxHeight="300"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     MouseDoubleClick="ResultList_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="AccentBar" Width="3" CornerRadius="2" Margin="3,6"
                                                    Background="Transparent"/>
                                            <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PickerSelBg}"/>
                                            <Setter TargetName="AccentBar" Property="Background" Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PickerHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{StaticResource PickerChipBg}" CornerRadius="5" Padding="7,1.5" Margin="0,0,9,0">
                                    <TextBlock Text="{Binding Keyword}" FontFamily="Cascadia Code, Consolas" FontSize="12.5"
                                               Foreground="#9BA6FF" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Text="{Binding Label}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource PickerText}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Preview}" FontSize="12" Foreground="{StaticResource PickerSub}"
                                       TextTrimming="CharacterEllipsis" Margin="1,3,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyText" Grid.Row="2" Margin="0,18,0,10"
                       Text="一致するスニペットがありません"
                       Foreground="{StaticResource PickerSub}" HorizontalAlignment="Center"
                       Visibility="Collapsed"/>

            <!-- ヒントバー -->
            <Grid Grid.Row="3" Margin="8,8,8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="↑↓" Foreground="{StaticResource PickerText}" FontSize="11" Margin="0,0,4,0"/>
                    <TextBlock Text="選択" Foreground="{StaticResource PickerSub}" FontSize="11" Margin="0,0,12,0"/>
                    <TextBlock Text="Enter" Foreground="{StaticResource PickerText}" FontSize="11" Margin="0,0,4,0"/>
                    <TextBlock Text="貼り付け" Foreground="{StaticResource PickerSub}" FontSize="11" Margin="0,0,12,0"/>
                    <TextBlock Text="Ctrl+Enter" Foreground="{StaticResource PickerText}" FontSize="11" Margin="0,0,4,0"/>
                    <TextBlock Text="コピー" Foreground="{StaticResource PickerSub}" FontSize="11" Margin="0,0,12,0"/>
                    <TextBlock Text="Esc" Foreground="{StaticResource PickerText}" FontSize="11" Margin="0,0,4,0"/>
                    <TextBlock Text="閉じる" Foreground="{StaticResource PickerSub}" FontSize="11"/>
                </StackPanel>
                <TextBlock Text="Znip" HorizontalAlignment="Right" Foreground="{StaticResource PickerSub}"
                           FontSize="11" FontWeight="SemiBold"/>
            </Grid>
        </Grid>
    </Border>
</Window>
