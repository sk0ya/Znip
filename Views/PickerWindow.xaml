<Window x:Class="Znip.Views.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Znip"
        Icon="/Znip.ico"
        Width="720" MaxHeight="640"
        SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI, Yu Gothic UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- ダーク面用のスクロールバー -->
        <Style x:Key="PickerScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="{DynamicResource PickerThumb}" CornerRadius="4" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PickerThumbHover}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PickerThumbHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource PickerScrollThumb}"/>
                                </Track.Thumb>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Background="{DynamicResource PickerBg}" CornerRadius="14"
            BorderBrush="{DynamicResource PickerBorder}" BorderThickness="1" Margin="16"
            Effect="{DynamicResource PickerShadow}">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 検索欄 -->
            <Border Grid.Row="0" Background="Transparent" Padding="6,4,6,0"
                    MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="{DynamicResource PickerSub}" VerticalAlignment="Center" Margin="6,0,12,0"/>
                <Grid Grid.Column="1">
                    <TextBox x:Name="SearchBox"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource PickerText}"
                             CaretBrush="{DynamicResource AccentBrush}"
                             SelectionBrush="{DynamicResource AccentBrush}"
                             FontSize="16" Padding="0" Margin="0,12"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="SearchHint" Text="スニペットを検索…"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center" FontSize="16"
                               Foreground="{DynamicResource PickerSub}"/>
                </Grid>
            </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="14,10,28,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="名前" FontSize="14" Foreground="{DynamicResource PickerSub}"/>
                <TextBlock Grid.Column="1" Text="キーワード" FontSize="14" Foreground="{DynamicResource PickerSub}"/>
                <TextBlock Grid.Column="2" Text="グループ" FontSize="14" Foreground="{DynamicResource PickerSub}"/>
            </Grid>

            <!-- 結果リスト -->
            <ListBox x:Name="ResultList" Grid.Row="2"
                     BorderThickness="0"
                     Background="Transparent"
                     MaxHeight="330"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ToolTip="選んで内容を確認し、Enter で貼り付け"
                     SelectionChanged="ResultList_SelectionChanged"
                     >
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="Height" Value="44"/>
                        <Setter Property="Margin" Value="0,1,4,1"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="9" BorderBrush="Transparent" BorderThickness="2,0,0,0"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PickerHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PickerSelBg}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Snippet.Title}" FontSize="16" Margin="0,0,16,0"
                                       Foreground="{DynamicResource PickerText}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding Snippet.Keyword}" FontSize="16" Margin="0,0,16,0"
                                       Foreground="{DynamicResource PickerSub}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding GroupName}" FontSize="16"
                                       Foreground="{DynamicResource PickerSub}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 選択中のスニペットの本文(何が貼り付けられるかをその場で確かめられる) -->
            <Expander x:Name="PreviewPane" Grid.Row="3" Header="本文を確認" IsExpanded="False"
                      Foreground="{DynamicResource PickerSub}" FontSize="12" Margin="12,10,12,0">
                <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                    <TextBlock x:Name="PreviewText" FontSize="14" Foreground="{DynamicResource PickerText}"
                               TextWrapping="Wrap" LineHeight="22"/>
                </ScrollViewer>
            </Expander>

            <!-- 空の状態 -->
            <StackPanel x:Name="EmptyText" Grid.Row="2" Margin="0,22,0,16" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                           Foreground="{DynamicResource PickerSub}" Opacity="0.5" HorizontalAlignment="Center"/>
                <TextBlock Text="一致するスニペットがありません"
                           Foreground="{DynamicResource PickerSub}" FontSize="12.5"
                           Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- 貼り付けを主操作として明示する -->
            <Grid Grid.Row="4" Margin="8,12,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="↑↓ 選択   ·   Esc 閉じる" FontSize="12"
                           Foreground="{DynamicResource PickerSub}" VerticalAlignment="Center"/>
                <Button x:Name="CopyButton" Grid.Column="1" Content="コピー" Style="{StaticResource ToolButton}"
                        IsEnabled="{Binding IsEnabled, ElementName=PasteButton}" Click="Copy_Click" ToolTip="Ctrl+Enter"/>
                <Button x:Name="PasteButton" Grid.Column="2" Content="貼り付け  ↵"
                        Style="{StaticResource PrimaryButton}" Margin="0" Click="Paste_Click"/>
            </Grid>

        </Grid>
    </Border>
</Window>
