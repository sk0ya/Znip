<Window x:Class="Znip.Views.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Znip"
        Icon="/Znip.ico"
        Width="560" MaxHeight="580"
        SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI, Yu Gothic UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- ダーク面用のスクロールバー -->
        <Style x:Key="PickerScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="{DynamicResource PickerThumb}" CornerRadius="4" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PickerThumbHover}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PickerThumbHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource PickerScrollThumb}"/>
                                </Track.Thumb>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- キー表示用のチップ -->
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PickerKeyCapBg}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="KeyCapText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PickerSub}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="KeyCapLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PickerSub}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource PickerBg}" CornerRadius="14"
            BorderBrush="{DynamicResource PickerBorder}" BorderThickness="1" Margin="16"
            Effect="{DynamicResource PickerShadow}">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 検索欄 -->
            <Grid Grid.Row="0" Margin="6,4,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="{DynamicResource PickerSub}" VerticalAlignment="Center" Margin="6,0,12,0"/>
                <Grid Grid.Column="1">
                    <TextBox x:Name="SearchBox"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource PickerText}"
                             CaretBrush="{DynamicResource AccentBrush}"
                             SelectionBrush="{DynamicResource AccentBrush}"
                             FontSize="16" Padding="0,12"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="SearchHint" Text="スニペットを検索…"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center" FontSize="16"
                               Foreground="{DynamicResource PickerSub}"/>
                </Grid>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{DynamicResource PickerBorder}" Margin="-8,4,-8,6"/>

            <!-- 結果リスト -->
            <ListBox x:Name="ResultList" Grid.Row="2"
                     BorderThickness="0"
                     Background="Transparent"
                     MaxHeight="310"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     SelectionChanged="ResultList_SelectionChanged"
                     PreviewMouseLeftButtonUp="ResultList_PreviewMouseLeftButtonUp">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="Height" Value="40"/>
                        <Setter Property="Margin" Value="0,1,4,1"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="9"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PickerHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PickerSelBg}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <!-- 見出しを左に揃え、グループ名とキーワードは右端へ -->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Snippet.Title}" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PickerText}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding GroupName}" FontSize="11.5"
                                       Foreground="{DynamicResource PickerSub}" VerticalAlignment="Center"
                                       MaxWidth="110" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
                            <!-- キーワードは設定画面の一覧と同じ等幅の札 -->
                            <Border x:Name="KeywordTag" Grid.Column="2" Margin="10,0,0,0" CornerRadius="5"
                                    Padding="6,0" Height="20" VerticalAlignment="Center"
                                    Background="{DynamicResource PickerChipBg}">
                                <TextBlock Text="{Binding Snippet.Keyword}" MaxWidth="130"
                                           FontFamily="Cascadia Code, Consolas" FontSize="11.5"
                                           Foreground="{DynamicResource PickerChipText}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Snippet.HasKeyword}" Value="False">
                                <Setter TargetName="KeywordTag" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 選択中のスニペットの本文(何が貼り付けられるかをその場で確かめられる) -->
            <Border x:Name="PreviewPane" Grid.Row="3" Background="{DynamicResource PickerKeyCapBg}"
                    BorderBrush="{DynamicResource PickerBorder}" BorderThickness="1"
                    CornerRadius="9" Padding="12,9" Margin="2,8,2,0">
                <TextBlock x:Name="PreviewText" FontFamily="Cascadia Code, Consolas, Meiryo" FontSize="12"
                           Foreground="{DynamicResource PickerText}" TextWrapping="Wrap"
                           MaxHeight="88" TextTrimming="CharacterEllipsis" LineHeight="18"/>
            </Border>

            <!-- 空の状態 -->
            <StackPanel x:Name="EmptyText" Grid.Row="2" Margin="0,22,0,16" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                           Foreground="{DynamicResource PickerSub}" Opacity="0.5" HorizontalAlignment="Center"/>
                <TextBlock Text="一致するスニペットがありません"
                           Foreground="{DynamicResource PickerSub}" FontSize="12.5"
                           Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- ヒントバー -->
            <Grid Grid.Row="4" Margin="8,10,8,4">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource KeyCap}">
                        <TextBlock Text="↑↓" Style="{StaticResource KeyCapText}"/>
                    </Border>
                    <TextBlock Text="選択" Style="{StaticResource KeyCapLabel}"/>
                    <Border Style="{StaticResource KeyCap}">
                        <TextBlock Text="Enter" Style="{StaticResource KeyCapText}"/>
                    </Border>
                    <TextBlock Text="貼り付け(クリックでも可)" Style="{StaticResource KeyCapLabel}"/>
                    <Border Style="{StaticResource KeyCap}">
                        <TextBlock Text="Ctrl+Enter" Style="{StaticResource KeyCapText}"/>
                    </Border>
                    <TextBlock Text="コピー" Style="{StaticResource KeyCapLabel}"/>
                    <Border Style="{StaticResource KeyCap}">
                        <TextBlock Text="Esc" Style="{StaticResource KeyCapText}"/>
                    </Border>
                    <TextBlock Text="閉じる" Style="{StaticResource KeyCapLabel}" Margin="0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Width="14" Height="14" CornerRadius="4" Background="{DynamicResource LogoBrush}">
                        <TextBlock Text="Z" Foreground="White" FontWeight="Bold" FontSize="8.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Znip" Foreground="{DynamicResource PickerSub}" Margin="6,0,0,0"
                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
