<Window x:Class="Znip.Views.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Znip"
        Icon="/Znip.ico"
        Width="520" MaxHeight="460"
        SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI, Yu Gothic UI"
        UseLayoutRounding="True"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- ダーク面用のスクロールバー -->
        <Style x:Key="PickerScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="{DynamicResource PickerThumb}" CornerRadius="4" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PickerThumbHover}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PickerThumbHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource PickerScrollThumb}"/>
                                </Track.Thumb>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- キー表示用のチップ -->
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PickerKeyCapBg}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="KeyCapText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PickerSub}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="KeyCapLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PickerSub}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource PickerBg}" CornerRadius="14"
            BorderBrush="{DynamicResource PickerBorder}" BorderThickness="1" Margin="16"
            Effect="{DynamicResource PickerShadow}">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 検索欄 -->
            <Grid Grid.Row="0" Margin="6,4,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="{DynamicResource PickerSub}" VerticalAlignment="Center" Margin="6,0,12,0"/>
                <Grid Grid.Column="1">
                    <TextBox x:Name="SearchBox"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource PickerText}"
                             CaretBrush="{DynamicResource AccentBrush}"
                             SelectionBrush="{DynamicResource AccentBrush}"
                             FontSize="17" Padding="0,11"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="SearchHint" Text="スニペットを検索…"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center" FontSize="17"
                               Foreground="{DynamicResource PickerSub}"/>
                </Grid>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{DynamicResource PickerBorder}" Margin="2,4,2,6"/>

            <!-- 結果リスト -->
            <ListBox x:Name="ResultList" Grid.Row="2"
                     BorderThickness="0"
                     Background="Transparent"
                     MaxHeight="310"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     MouseDoubleClick="ResultList_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="AccentBar" Width="3" CornerRadius="2" Margin="3,7"
                                                    Background="Transparent"/>
                                            <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PickerHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PickerSelBg}"/>
                                            <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{DynamicResource PickerChipBg}" CornerRadius="5" Padding="7,2" Margin="0,0,9,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasKeyword}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Keyword}" FontFamily="Cascadia Code, Consolas" FontSize="12.5"
                                               Foreground="{DynamicResource PickerChipText}" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Text="{Binding Label}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PickerText}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Preview}" FontSize="12" Foreground="{DynamicResource PickerSub}"
                                       TextTrimming="CharacterEllipsis" Margin="1,4,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空の状態 -->
            <StackPanel x:Name="EmptyText" Grid.Row="2" Margin="0,22,0,16" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                           Foreground="{DynamicResource PickerSub}" Opacity="0.5" HorizontalAlignment="Center"/>
                <TextBlock Text="一致するスニペットがありません"
                           Foreground="{DynamicResource PickerSub}" FontSize="12.5"
                           Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- ヒントバー -->
            <Grid Grid.Row="3" Margin="8,10,8,4">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource KeyCap}">
                        <TextBlock Text="↑↓" Style="{StaticResource KeyCapText}"/>
                    </Border>
                    <TextBlock Text="選択" Style="{StaticResource KeyCapLabel}"/>
                    <Border Style="{StaticResource KeyCap}">
                        <TextBlock Text="Enter" Style="{StaticResource KeyCapText}"/>
                    </Border>
                    <TextBlock Text="貼り付け" Style="{StaticResource KeyCapLabel}"/>
                    <Border Style="{StaticResource KeyCap}">
                        <TextBlock Text="Ctrl+Enter" Style="{StaticResource KeyCapText}"/>
                    </Border>
                    <TextBlock Text="コピー" Style="{StaticResource KeyCapLabel}"/>
                    <Border Style="{StaticResource KeyCap}">
                        <TextBlock Text="Esc" Style="{StaticResource KeyCapText}"/>
                    </Border>
                    <TextBlock Text="閉じる" Style="{StaticResource KeyCapLabel}" Margin="0"/>
                </StackPanel>
                <TextBlock Text="Znip" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFaint}"
                           FontSize="11" FontWeight="SemiBold"/>
            </Grid>
        </Grid>
    </Border>
</Window>
