<Window x:Class="Znip.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Znip"
        Icon="/Znip.ico"
        Width="1100" Height="700" MinWidth="880" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ChromeBg}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Yu Gothic UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- ===== タイトルバー ===== -->
        <!-- ここは WindowChrome のキャプション領域なので、空きをドラッグすれば窓が動く -->
        <Grid Grid.Row="0" Background="{DynamicResource ChromeBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ロゴ(アイコンと同じティール→インディゴ) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,16,0">
                <Border Width="24" Height="24" CornerRadius="7" Background="{DynamicResource LogoBrush}">
                    <TextBlock Text="Z" Foreground="White" FontWeight="Bold" FontSize="13.5"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Znip" Foreground="{DynamicResource TextMain}"
                           FontSize="13.5" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="9,0,0,0"/>
            </StackPanel>

            <!-- ページ切り替えタブ -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <RadioButton x:Name="NavSnippets" Style="{StaticResource TopTab}" GroupName="Page"
                             Content="スニペット" IsChecked="True" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavSettings" Style="{StaticResource TopTab}" GroupName="Page"
                             Content="設定" Checked="Nav_Checked"/>
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_Click"
                        ToolTip="最小化" WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButton}" Content="&#xE922;"
                        Click="Maximize_Click" ToolTip="最大化"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" Click="CloseButton_Click"
                        ToolTip="閉じる(トレイに常駐します)" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource BorderSoft}"/>

        <!-- ===== スニペットページ ===== -->
        <Grid x:Name="SnippetsPanel" Grid.Row="2" Background="{DynamicResource ContentBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="204" MinWidth="150"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="1.15*" MinWidth="230"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="2.1*" MinWidth="330"/>
            </Grid.ColumnDefinitions>

            <!-- グループ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="グループ" Style="{StaticResource PaneLabel}" Margin="18,0,0,0"/>

                <ListBox x:Name="GroupList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                         Margin="8,0,6,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="GroupList_SelectionChanged"
                         PreviewMouseRightButtonDown="GroupList_PreviewMouseRightButtonDown"
                         ContextMenuOpening="GroupList_ContextMenuOpening">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,7"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverSoft}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="13"
                                           Foreground="{DynamicResource TextMain}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="11.5"
                                           Foreground="{DynamicResource TextFaint}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="名前を変更..." Click="RenameGroup_Click"/>
                            <MenuItem Header="削除" Click="DeleteGroup_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>

                <Button Grid.Row="2" Style="{StaticResource GhostRowButton}" Margin="8,4,6,10"
                        Click="AddGroup_Click" ToolTip="グループを追加">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock Text="グループを追加" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <GridSplitter Grid.Column="1" Style="{StaticResource PaneSplitter}"/>

            <!-- 一覧 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 検索 + 新規 -->
                <Grid Grid.Row="0" Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{DynamicResource TextFaint}"
                               VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="FilterBox" Style="{StaticResource PlainBox}"
                                 TextChanged="FilterBox_TextChanged"/>
                        <TextBlock x:Name="FilterHint" Text="検索"
                                   IsHitTestVisible="False" FontSize="13"
                                   Foreground="{DynamicResource TextFaint}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <Button x:Name="ClearFilterButton" Grid.Column="2" Style="{StaticResource IconButton}"
                            Content="&#xE711;" FontSize="10" Width="24" Height="24"
                            Visibility="Collapsed" Click="ClearFilter_Click"
                            ToolTip="検索をクリア"/>
                    <Button Grid.Column="3" Style="{StaticResource AccentIconButton}" Content="&#xE710;"
                            Margin="8,0,0,0" Click="New_Click" ToolTip="スニペットを新しく作る"/>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource BorderSoft}"/>

                <ListBox x:Name="SnippetList" Grid.Row="2" BorderThickness="0" Background="Transparent"
                         Margin="8,6,6,6"
                         HorizontalContentAlignment="Stretch"
                         SelectionChanged="SnippetList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="11,8"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="Marker" CornerRadius="2" Margin="0,8"
                                                        Background="Transparent"/>
                                                <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverSoft}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                <Setter TargetName="Marker" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- キーワードが無いスニペット(BeefText からの取り込み等)ではチップを出さない。
                                         MinWidth を揃えておくと右の名前の頭が縦に並んで読みやすい -->
                                    <Border Background="{DynamicResource TealSoftBrush}" CornerRadius="5"
                                            Padding="7,2" Margin="0,0,9,0" MinWidth="56">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasKeyword}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Keyword}" FontFamily="Cascadia Code, Consolas"
                                                   FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TealTextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Label}"
                                               Foreground="{DynamicResource TextMain}"
                                               FontSize="13" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                                <TextBlock Text="{Binding Preview}" FontSize="11.5"
                                           Foreground="{DynamicResource TextFaint}"
                                           TextTrimming="CharacterEllipsis" Margin="1,4,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="複製" Click="Duplicate_Click"/>
                            <MenuItem Header="削除" Click="Delete_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>

                <!-- 空の状態 -->
                <StackPanel x:Name="ListEmptyPanel" Grid.Row="2" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0,20,24">
                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                               Foreground="{DynamicResource BorderStrong}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ListEmptyText" Margin="0,12,0,0" TextAlignment="Center"
                               Style="{StaticResource HelpText}"
                               Foreground="{DynamicResource TextFaint}"/>
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="3" Style="{StaticResource PaneSplitter}"/>

            <!-- エディタ -->
            <Grid Grid.Column="4" Background="{DynamicResource CardBg}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20,0,8,0">
                    <TextBlock Text="スニペットの編集" Style="{StaticResource PaneLabel}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="DuplicateButton" Style="{StaticResource IconButton}" Content="&#xE8C8;"
                                Click="Duplicate_Click" ToolTip="このスニペットを複製する"/>
                        <Button x:Name="DeleteButton" Style="{StaticResource DangerIconButton}" Content="&#xE74D;"
                                Click="Delete_Click" ToolTip="このスニペットを削除する"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource BorderSoft}"/>

                <Grid Grid.Row="2">
                    <Grid x:Name="EditorPanel" Margin="20,18,20,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- キーワード / グループ -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="キーワード" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="KeywordBox" Style="{StaticResource InputBox}"
                                         FontFamily="Cascadia Code, Consolas"
                                         FontWeight="SemiBold"
                                         Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="このキーワードを入力すると本文に置き換わります(例: ;addr)"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="グループ" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="GroupComboBox" Style="{StaticResource InputCombo}"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding GroupId, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="このスニペットが属するグループ">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- 名前 -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,16">
                            <TextBlock Text="名前(任意)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource InputBox}"
                                     Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="一覧やピッカーに表示される名前"/>
                        </StackPanel>

                        <!-- 本文の見出し + 変数チップ -->
                        <Grid Grid.Row="2" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="本文" Style="{StaticResource FieldLabel}"
                                       Margin="2,0,10,0" VerticalAlignment="Bottom"/>
                            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Content="{}{date}" Style="{StaticResource ChipButton}"
                                        Click="InsertVariable_Click" Tag="{}{date}"
                                        ToolTip="今日の日付 (書式指定: {date:yyyy-MM-dd})"/>
                                <Button Content="{}{time}" Style="{StaticResource ChipButton}"
                                        Click="InsertVariable_Click" Tag="{}{time}"
                                        ToolTip="現在時刻 (書式指定: {time:HH:mm})"/>
                                <Button Content="{}{clipboard}" Style="{StaticResource ChipButton}"
                                        Click="InsertVariable_Click" Tag="{}{clipboard}"
                                        ToolTip="クリップボードの内容"/>
                                <Button Content="{}{cursor}" Style="{StaticResource ChipButton}"
                                        Click="InsertVariable_Click" Tag="{}{cursor}"
                                        ToolTip="貼り付け後のカーソル位置"/>
                            </WrapPanel>
                        </Grid>

                        <TextBox x:Name="ContentBox" Grid.Row="3" Style="{StaticResource InputBox}"
                                 Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" AcceptsTab="True"
                                 FontFamily="Cascadia Code, Consolas, Meiryo"
                                 Padding="13,10"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"/>
                    </Grid>

                    <!-- 未選択時のプレースホルダ -->
                    <StackPanel x:Name="EditorPlaceholder" Visibility="Collapsed"
                                VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                   Foreground="{DynamicResource BorderStrong}" HorizontalAlignment="Center"/>
                        <TextBlock Text="編集するスニペットを選んでください"
                                   Margin="0,14,0,0" FontSize="13.5" TextAlignment="Center"
                                   Foreground="{DynamicResource TextSub}"/>
                        <TextBlock Text="右上の ＋ から新しく作れます"
                                   Margin="0,5,0,0" FontSize="12.5" TextAlignment="Center"
                                   Foreground="{DynamicResource TextFaint}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== 設定ページ ===== -->
        <ScrollViewer x:Name="SettingsPanel" Grid.Row="2" Visibility="Collapsed"
                      Background="{DynamicResource ChromeBg}"
                      Padding="0,0,4,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="700" HorizontalAlignment="Left" Margin="28,22,28,28">

                <!-- 外観 -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="外観" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,14"
                                   Text="設定画面とピッカーの配色を切り替えます。"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ThemeSystemRadio" GroupName="Theme" Content="システムに従う"
                                         Checked="Theme_Changed"/>
                            <RadioButton x:Name="ThemeLightRadio" GroupName="Theme" Content="ライト"
                                         Checked="Theme_Changed"/>
                            <RadioButton x:Name="ThemeDarkRadio" GroupName="Theme" Content="ダーク"
                                         Checked="Theme_Changed" Margin="0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ホットキー -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="&#xEDA7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="ピッカーの呼び出しホットキー" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,14"
                                   Text="下の欄をクリックして、使いたいキーの組み合わせを押してください(修飾キー必須)。"/>
                        <TextBox x:Name="HotkeyBox" Style="{StaticResource InputBox}" Width="260"
                                 HorizontalAlignment="Left" MinHeight="40"
                                 IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Hand"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                 PreviewMouseLeftButtonDown="HotkeyBox_PreviewMouseLeftButtonDown"
                                 LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"
                                 TextAlignment="Center"
                                 FontSize="13.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="HotkeyStatus" Foreground="{DynamicResource TextFaint}" FontSize="12"
                                   Margin="2,9,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 自動展開 -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="自動展開" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        <CheckBox x:Name="AutoExpandCheck" Content="キーワードを入力したら自動で展開する(BeefText方式)"
                                  Checked="AutoExpand_Changed" Unchecked="AutoExpand_Changed"/>
                        <TextBlock Style="{StaticResource HelpText}" Margin="28,9,0,0"
                                   Text="どのアプリでも、キーワード(例: ;date)を打ち終わった瞬間に本文へ置き換わります。&#x0a;※ 半角の直接入力が対象です。IME で変換中の文字列からは展開されません。&#x0a;※ 誤爆を防ぐため、キーワードの先頭に「;」などの記号を付けるのがおすすめです。"/>
                    </StackPanel>
                </Border>

                <!-- 起動 -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="起動" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        <CheckBox x:Name="StartupCheck" Content="Windows 起動時に Znip を自動で起動する"
                                  Checked="Startup_Changed" Unchecked="Startup_Changed"/>
                    </StackPanel>
                </Border>

                <!-- 移行 -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="BeefText からの移行" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource HelpText}" Margin="0,0,0,14"
                                   Text="BeefText の comboList.json を指定して、スニペットと設定(自動展開・起動時実行・ホットキー)を取り込みます。&#x0a;キーワードが重複するスニペットはスキップされます。キーワードが無いスニペットも取り込み、ピッカーから選んで使えます。&#x0a;未編集の既定スニペットが残っている場合は、置き換えるかどうかを確認します。"/>
                        <Button Content="ファイルを選んでインポート..." Style="{StaticResource ToolButton}"
                                HorizontalAlignment="Left" Margin="0" Click="ImportBeefText_Click"/>
                    </StackPanel>
                </Border>

                <!-- データ -->
                <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="データ" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        <Border Background="{DynamicResource FieldBg}" CornerRadius="8" Padding="11,8"
                                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1"
                                Margin="0,0,0,14">
                            <TextBlock x:Name="DataPathText" Foreground="{DynamicResource TextSub}" FontSize="11.5"
                                       FontFamily="Cascadia Code, Consolas" TextWrapping="Wrap"/>
                        </Border>
                        <Button Content="データフォルダを開く" Style="{StaticResource ToolButton}"
                                HorizontalAlignment="Left" Margin="0" Click="OpenDataFolder_Click"/>
                    </StackPanel>
                </Border>

                <!-- 変数一覧 -->
                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <TextBlock Text="使える変数" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>
                        <ItemsControl x:Name="VariableList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="170"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource TealSoftBrush}" CornerRadius="5"
                                                Padding="7,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Name}" FontFamily="Cascadia Code, Consolas"
                                                       FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TealTextBrush}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Description}"
                                                   Foreground="{DynamicResource TextSub}" FontSize="12.5"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Background="{DynamicResource BorderSoft}"/>

        <!-- ===== ステータスバー ===== -->
        <Grid Grid.Row="4" Background="{DynamicResource ChromeBg}">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="16,0,0,0"
                       Foreground="{DynamicResource TextSub}" FontSize="11.5"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,16,0">
                <Border Background="{DynamicResource FieldBg}" CornerRadius="5" Padding="7,1"
                        BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1">
                    <TextBlock x:Name="HotkeyHintText" Foreground="{DynamicResource TextSub}"
                               FontSize="11" FontWeight="SemiBold"/>
                </Border>
                <TextBlock Text="でピッカーを開く" Foreground="{DynamicResource TextFaint}" FontSize="11.5"
                           VerticalAlignment="Center" Margin="7,0,0,0"/>
                <Border Width="1" Height="12" Background="{DynamicResource BorderSoft}" Margin="14,0"/>
                <TextBlock x:Name="SaveIndicator" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFaint}" FontSize="11.5"
                           Text="変更は自動保存されます"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
