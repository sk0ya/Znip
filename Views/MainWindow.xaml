<Window x:Class="Znip.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Znip"
        Width="960" Height="620" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ContentBg}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Yu Gothic UI"
        Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="204"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ サイドバー ============ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ロゴ -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,20,20,24">
                    <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="Z" Foreground="White" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Znip" Foreground="White" FontSize="17" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <!-- ナビ -->
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavSnippets" Style="{StaticResource NavItem}" Tag="&#xE8C8;"
                                 Content="スニペット" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="&#xE713;"
                                 Content="設定" Checked="Nav_Checked"/>
                </StackPanel>

                <!-- フッター: ホットキー -->
                <Border Grid.Row="2" Margin="14,0,14,16" CornerRadius="8"
                        Background="{StaticResource SidebarItemHover}" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="ピッカー呼び出し" Foreground="{StaticResource SidebarText}" FontSize="11"/>
                        <TextBlock x:Name="HotkeyHintText" Foreground="White" FontSize="13"
                                   FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ 右側 ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- タイトルバー -->
            <Grid Grid.Row="0">
                <TextBlock x:Name="PageTitle" Text="スニペット" VerticalAlignment="Center"
                           Margin="24,0,0,0" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMain}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="Maximize_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" Click="CloseButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>

            <!-- ============ スニペットページ ============ -->
            <Grid x:Name="SnippetsPanel" Grid.Row="1" Margin="24,8,24,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ツールバー -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="＋ 新規" Style="{StaticResource PrimaryButton}" Click="New_Click"/>
                        <Button x:Name="DuplicateButton" Content="複製" Style="{StaticResource ToolButton}" Click="Duplicate_Click"/>
                        <Button x:Name="DeleteButton" Content="削除" Style="{StaticResource ToolButton}" Click="Delete_Click"/>
                    </StackPanel>
                    <Grid Width="230" HorizontalAlignment="Right">
                        <TextBox x:Name="FilterBox"
                                 Style="{StaticResource InputBox}"
                                 TextChanged="FilterBox_TextChanged"/>
                        <StackPanel x:Name="FilterHint" Orientation="Horizontal"
                                    IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="{StaticResource TextSub}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="検索" Foreground="{StaticResource TextSub}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- リスト + エディタ -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <ListBox x:Name="SnippetList" BorderThickness="0" Background="Transparent"
                                 Margin="6" HorizontalContentAlignment="Stretch"
                                 SelectionChanged="SnippetList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverSoft}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="5" Padding="7,1.5" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Keyword}" FontFamily="Cascadia Code, Consolas" FontSize="12"
                                                           Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextMain}"
                                                       FontSize="13" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Preview}" FontSize="11.5" Foreground="{StaticResource TextSub}"
                                                   TextTrimming="CharacterEllipsis" Margin="1,3,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- エディタ -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                        <Grid x:Name="EditorPanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="キーワード" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="KeywordBox" Style="{StaticResource InputBox}"
                                             FontFamily="Cascadia Code, Consolas"
                                             Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="このキーワードを入力すると本文に置き換わります(例: ;addr)"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="名前(任意)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource InputBox}"
                                             Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="一覧に表示される名前"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="本文" Style="{StaticResource FieldLabel}" VerticalAlignment="Bottom"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="変数:" VerticalAlignment="Center" Foreground="{StaticResource TextSub}"
                                               FontSize="12" Margin="0,0,8,0"/>
                                    <Button Content="{}{date}" Style="{StaticResource ToolButton}" Padding="8,3" FontSize="11.5"
                                            FontFamily="Cascadia Code, Consolas"
                                            Click="InsertVariable_Click" Tag="{}{date}" ToolTip="今日の日付 (書式指定: {date:yyyy-MM-dd})"/>
                                    <Button Content="{}{time}" Style="{StaticResource ToolButton}" Padding="8,3" FontSize="11.5"
                                            FontFamily="Cascadia Code, Consolas"
                                            Click="InsertVariable_Click" Tag="{}{time}" ToolTip="現在時刻 (書式指定: {time:HH:mm})"/>
                                    <Button Content="{}{clipboard}" Style="{StaticResource ToolButton}" Padding="8,3" FontSize="11.5"
                                            FontFamily="Cascadia Code, Consolas"
                                            Click="InsertVariable_Click" Tag="{}{clipboard}" ToolTip="クリップボードの内容"/>
                                    <Button Content="{}{cursor}" Style="{StaticResource ToolButton}" Padding="8,3" FontSize="11.5" Margin="0"
                                            FontFamily="Cascadia Code, Consolas"
                                            Click="InsertVariable_Click" Tag="{}{cursor}" ToolTip="貼り付け後のカーソル位置"/>
                                </StackPanel>
                            </Grid>

                            <TextBox x:Name="ContentBox" Grid.Row="2" Style="{StaticResource InputBox}"
                                     Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" AcceptsTab="True"
                                     FontFamily="Cascadia Code, Consolas, Meiryo" FontSize="13.5"
                                     Padding="12,10"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"/>

                            <TextBlock Grid.Row="3" Margin="2,10,0,0" FontSize="12" Foreground="{StaticResource TextSub}"
                                       Text="変更は自動保存されます。キーワードを打つと自動展開、ホットキーからピッカーでも呼び出せます。"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ステータス -->
                <TextBlock x:Name="StatusText" Grid.Row="2" Margin="2,10,0,0"
                           Foreground="{StaticResource TextSub}" FontSize="12"/>
            </Grid>

            <!-- ============ 設定ページ ============ -->
            <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" Margin="24,8,24,16"
                          VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel MaxWidth="620" HorizontalAlignment="Left">

                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="ピッカーの呼び出しホットキー" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="下の欄をクリックして、使いたいキーの組み合わせを押してください(修飾キー必須)。"
                                       Foreground="{StaticResource TextSub}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBox x:Name="HotkeyBox" Style="{StaticResource InputBox}" Width="260" HorizontalAlignment="Left"
                                     IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Hand"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                     FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="HotkeyStatus" Foreground="{StaticResource TextSub}" FontSize="12" Margin="2,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="自動展開" Style="{StaticResource SectionTitle}"/>
                            <CheckBox x:Name="AutoExpandCheck" Content="キーワードを入力したら自動で展開する(BeefText方式)"
                                      Foreground="{StaticResource TextMain}"
                                      Checked="AutoExpand_Changed" Unchecked="AutoExpand_Changed"/>
                            <TextBlock Foreground="{StaticResource TextSub}" FontSize="12" TextWrapping="Wrap" Margin="24,6,0,0"
                                       Text="どのアプリでも、キーワード(例: ;date)を打ち終わった瞬間に本文へ置き換わります。&#x0a;※ 半角の直接入力が対象です。IME で変換中の文字列からは展開されません。&#x0a;※ 誤爆を防ぐため、キーワードの先頭に「;」などの記号を付けるのがおすすめです。"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="起動" Style="{StaticResource SectionTitle}"/>
                            <CheckBox x:Name="StartupCheck" Content="Windows 起動時に Znip を自動で起動する"
                                      Foreground="{StaticResource TextMain}"
                                      Checked="Startup_Changed" Unchecked="Startup_Changed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="BeefTextからの移行" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Foreground="{StaticResource TextSub}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="BeefText の comboList.json を指定して、スニペットと設定(自動展開・起動時実行・ホットキー)を取り込みます。&#x0a;キーワードが重複するスニペットはスキップされます。"/>
                            <Button Content="ファイルを選んでインポート..." Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Click="ImportBeefText_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="データ" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="DataPathText" Foreground="{StaticResource TextSub}" FontSize="12" Margin="0,0,0,10"/>
                            <Button Content="データフォルダを開く" Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Click="OpenDataFolder_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="使える変数" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Foreground="{StaticResource TextSub}" FontSize="12.5"
                                       FontFamily="Cascadia Code, Consolas, Meiryo" TextWrapping="Wrap" LineHeight="22"
                                       Text="{}{date}              今日の日付 (yyyy/MM/dd)&#x0a;{date:yyyy年M月d日}   書式指定も可能&#x0a;{time}              現在時刻 (HH:mm)&#x0a;{clipboard}         クリップボードの内容&#x0a;{cursor}            貼り付け後にカーソルを置く位置"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
